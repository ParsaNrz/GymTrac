# GymTrac Environment Configuration
# Copy this file to .env and fill in your values.
# IMPORTANT: .env is gitignored — never commit real secrets.

# ---------- JWT ----------
# Secret key for signing JWT tokens.
# Generate a random string, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-random-secret-key

# Token expiration in minutes (default: 1440 = 24 hours)
JWT_EXPIRATION_MINUTES=1440

# ---------- Database ----------
# Async SQLite URL. The database file will be created in the backend/data/ directory.
DATABASE_URL=sqlite+aiosqlite:///./data/gym_trac.db

# ---------- Admin Seed (first-run only) ----------
# The initial admin account is created automatically on first startup
# if no admin user exists. Use these environment variables to set the
# initial admin credentials. Change them after first run if desired.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password-after-first-login

# ---------- Frontend ----------
# Vite dev server port (default: 5173)
# VITE_PORT=5173

# ---------- Backend ----------
# Uvicorn host (default: 127.0.0.1)
# UVICORN_HOST=127.0.0.1
# Uvicorn port (default: 8000)
# UVICORN_PORT=8000
